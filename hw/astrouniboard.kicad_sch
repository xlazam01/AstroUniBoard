	)
	(text "Tab 4 x 10 mm on the left board edge, attached over its full\nwidth by one mouse-bite row (MB1: 4 NPTH 0.6 mm, 1.0 mm pitch).\nNo copper crosses the snap line: SENS_* are the tab's own nets.\nSnap off, then wire to J9: SDA -> 1, SCL -> 2, VDD -> 3, GND -> 4.\nPads: VDD and GND on top, SDA and SCL on the bottom. No pour.\nSHT40-AD1B = 0x44 (on-board U8 SHT40-BD1B = 0x45)."
		(exclude_from_sim no)
		(at 391.16 403.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "987d07cd-8f54-4b0c-97f1-4cb319d10ef1")
	)
